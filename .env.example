DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/petcare
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
MEDIA_DIR=media
MAX_UPLOAD_SIZE_BYTES=5242880
# Logging: LOG_LEVEL is DEBUG/INFO/WARNING/ERROR; LOG_FORMAT is json (servers) or text (local).
LOG_LEVEL=INFO
LOG_FORMAT=json
# Sage Logs push endpoint. Example: https://sage.example/api/hack-led-22/multiline/
SAGE_LOG_URL=
# Token is injected by CI/CD as SAGE_API_TOKEN and sent as Bearer authentication.
SAGE_API_TOKEN=
SAGE_LOG_TIMEOUT_SECONDS=5
